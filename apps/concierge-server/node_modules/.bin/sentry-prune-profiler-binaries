#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules/@sentry/profiling-node/scripts/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules/@sentry/profiling-node/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules/@sentry/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules/@sentry/profiling-node/scripts/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules/@sentry/profiling-node/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules/@sentry/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/@sentry+profiling-node@10.19.0/node_modules:/workspaces/RastaGPT-Concierge/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@sentry/profiling-node/scripts/prune-profiler-binaries.js" "$@"
else
  exec node  "$basedir/../@sentry/profiling-node/scripts/prune-profiler-binaries.js" "$@"
fi
